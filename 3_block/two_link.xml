<mujoco model="3R_planar_robot">

    <compiler angle="radian" />

    <option timestep="0.002"
        gravity="0 -9.81 0"
        integrator="RK4">
        <flag energy="enable" />
    </option>

    <visual>
        <global offwidth="1280" offheight="720" />
    </visual>

    <worldbody>

        <light pos="0 0 5" />

        <body name="link1" pos="0 0 0">

            <joint name="joint1"
                type="hinge"
                axis="0 0 1"
                damping="0" />

            <inertial pos="0.5 0 0"
                mass="1"
                diaginertia="0.001 0.1 0.1" />

            <geom type="capsule"
                fromto="0 0 0 1 0 0"
                size="0.035"
                mass="0"
                rgba="1 0 0 1" />

            <body name="link2" pos="1 0 0">

                <joint name="joint2"
                    type="hinge"
                    axis="0 0 1"
                    damping="0" />

                <inertial pos="0.5 0 0"
                    mass="1"
                    diaginertia="0.001 0.1 0.1" />

                <geom type="capsule"
                    fromto="0 0 0 1 0 0"
                    size="0.035"
                    mass="0"
                    rgba="0 0 1 1" />

                <body name="link3" pos="1 0 0">

                    <joint name="joint3"
                        type="hinge"
                        axis="0 0 1"
                        damping="0" />

                    <inertial pos="0.125 0 0"
                        mass="0.2"
                        diaginertia="0.001 0.02 0.02" />

                    <geom type="capsule"
                        fromto="0 0 0 0.25 0 0"
                        size="0.025"
                        mass="0"
                        rgba="0 1 0 1" />

                    <site name="end_effector"
                        pos="0.25 0 0"
                        size="0.03"
                        rgba="1 1 0 1" />

                </body>
            </body>
        </body>

    </worldbody>

</mujoco>