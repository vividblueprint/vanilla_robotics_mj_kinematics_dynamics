<mujoco model="balance_bot">

    <compiler angle="radian"
        coordinate="local"
        meshdir="meshes"
        autolimits="true" />

    <default>
        <geom contype="1"
            conaffinity="1"
            friction="0.8 0.005 0.0001" />
    </default>

    <!-- ================= ASSETS ================= -->
    <asset>
        <mesh name="chassis_mesh"
            file="chassis.stl"
            scale="0.001 0.001 0.001" />

        <mesh name="wheel_left_mesh"
            file="wheel_left.stl"
            scale="0.001 0.001 0.001" />

        <mesh name="wheel_right_mesh"
            file="wheel_right.stl"
            scale="0.001 0.001 0.001" />
    </asset>

    <!-- ================= ROBOT ================= -->
    <worldbody>

        <body name="chassis" pos="0 0 0.0225">

            <freejoint name="root" />

            <geom name="chassis_geom"
                type="mesh"
                mesh="chassis_mesh"
                rgba="0.87 0.23 0.16 1.0" />

            <inertial pos="0 0 0.017"
                mass="0.127"
                diaginertia="0.000056790 0.000054532 0.000058722" />

            <!-- IMU -->
            <site name="imu_site"
                type="box"
                pos="-0.008 0.0225 0.040"
                size="0.003 0.003 0.00035"
                rgba="0 0 1 1" />

            <!-- Direction indicator -->
            <geom type="box"
                size="0.001 0.01 0.005"
                pos="0.027 0 0.02"
                rgba="0 1 0 1"
                contype="0"
                conaffinity="0" />

            <!-- LEFT WHEEL -->
            <body name="wheel_left" pos="0 0.04 0">

                <joint name="left_wheel_joint"
                    type="hinge"
                    axis="0 1 0"
                    damping="0.001"
                    frictionloss="0.001"
                    armature="4.5e-5" />

                <geom name="wheel_left_geom"
                    type="mesh"
                    mesh="wheel_left_mesh"
                    rgba="0.1 0.1 0.1 1" />

                <inertial pos="0 0 0"
                    mass="0.017"
                    diaginertia="0.000002611 0.000004303 0.000002611" />

            </body>

            <!-- RIGHT WHEEL -->
            <body name="wheel_right" pos="0 -0.04 0">

                <joint name="right_wheel_joint"
                    type="hinge"
                    axis="0 1 0"
                    damping="0.001"
                    frictionloss="0.001"
                    armature="4.5e-5" />

                <geom name="wheel_right_geom"
                    type="mesh"
                    mesh="wheel_right_mesh"
                    rgba="0.1 0.1 0.1 1" />

                <inertial pos="0 0 0"
                    mass="0.017"
                    diaginertia="0.000002611 0.000004303 0.000002611" />

            </body>

        </body>

    </worldbody>

    <!-- ================= ACTUATORS ================= -->
    <actuator>
        <motor name="left_motor"
            joint="left_wheel_joint"
            gear="0.05"
            ctrlrange="-1 1" />

        <motor name="right_motor"
            joint="right_wheel_joint"
            gear="0.05"
            ctrlrange="-1 1" />
    </actuator>

    <!-- ================= SENSORS ================= -->
    <sensor>
        <accelerometer name="imu_accel" site="imu_site" />
        <gyro name="imu_gyro" site="imu_site" />

        <framequat name="imu_orientation"
            objtype="site"
            objname="imu_site" />

        <jointpos name="left_wheel_pos"
            joint="left_wheel_joint" />

        <jointpos name="right_wheel_pos"
            joint="right_wheel_joint" />

        <jointvel name="left_wheel_vel"
            joint="left_wheel_joint" />

        <jointvel name="right_wheel_vel"
            joint="right_wheel_joint" />
    </sensor>

</mujoco>