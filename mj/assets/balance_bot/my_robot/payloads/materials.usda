#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "chassis_red"
    {
        color3f inputs:diffuseColor = (0.72934717, 0.043233637, 0.021980945)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/chassis_red/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/chassis_red.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/chassis_red.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/chassis_red.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/chassis_red.inputs:roughness>
            token outputs:surface
        }
    }

    def Material "wheel_black"
    {
        color3f inputs:diffuseColor = (0.010022825, 0.010022826, 0.010022825)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/wheel_black/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/wheel_black.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/wheel_black.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/wheel_black.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/wheel_black.inputs:roughness>
            token outputs:surface
        }
    }
}

