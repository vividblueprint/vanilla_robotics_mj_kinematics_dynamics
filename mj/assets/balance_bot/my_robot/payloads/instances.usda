#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "chassis" (
        prepend references = @./geometries.usd@</Geometries/chassis>
    )
    {
        over "chassis" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/chassis/VisualMaterials/chassis_red>
        }

        def Scope "VisualMaterials"
        {
            def Material "chassis_red" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/chassis_red>
            )
            {
            }
        }
    }

    def Xform "chassis_1" (
        prepend references = @./geometries.usd@</Geometries/chassis>
    )
    {
        over "chassis" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "wheel_left" (
        prepend references = @./geometries.usd@</Geometries/wheel_left>
    )
    {
        over "wheel_left" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/wheel_left/VisualMaterials/wheel_black>
        }

        def Scope "VisualMaterials"
        {
            def Material "wheel_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/wheel_black>
            )
            {
            }
        }
    }

    def Xform "wheel_left_1" (
        prepend references = @./geometries.usd@</Geometries/wheel_left>
    )
    {
        over "wheel_left" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }
}

