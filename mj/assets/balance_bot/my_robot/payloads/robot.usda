#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__bala2firesimplified_bSA"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__bala2firesimplified_bSA" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tn__bala2firesimplified_bSA/Physics/root_joint>,
        </tn__bala2firesimplified_bSA/Physics/left_wheel_joint>,
        </tn__bala2firesimplified_bSA/Physics/right_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tn__bala2firesimplified_bSA/Geometry/chassis>,
        </tn__bala2firesimplified_bSA/Geometry/chassis/wheel_left>,
        </tn__bala2firesimplified_bSA/Geometry/chassis/wheel_right>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "wheel_left" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_right" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

