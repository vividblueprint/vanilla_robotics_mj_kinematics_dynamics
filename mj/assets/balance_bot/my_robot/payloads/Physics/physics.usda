#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__bala2firesimplified_bSA"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__bala2firesimplified_bSA"
{
    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.00005679, 0.000054532, 0.000058722, 0, 0, 0]
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0.017)
            float3 physics:diagonalInertia = (0.000054532, 0.00005679, 0.000058722)
            float physics:mass = 0.127
            quatf physics:principalAxes = (6.123234e-17, 0.70710677, 0.70710677, 0)

            over "wheel_left" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000002611, 0.000004303, 0.000002611, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.000002611, 0.000002611, 0.000004303)
                float physics:mass = 0.017
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)
            }

            over "wheel_right" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000002611, 0.000004303, 0.000002611, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.000002611, 0.000002611, 0.000004303)
                float physics:mass = 0.017
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "left_wheel_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:damping = 0.000017453292
            float newton:friction = 0.001
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tn__bala2firesimplified_bSA/Geometry/chassis>
            custom rel physics:body1
            append rel physics:body1 = </tn__bala2firesimplified_bSA/Geometry/chassis/wheel_left>
            point3f physics:localPos0 = (0, 0.04, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "right_wheel_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:damping = 0.000017453292
            float newton:friction = 0.001
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tn__bala2firesimplified_bSA/Geometry/chassis>
            custom rel physics:body1
            append rel physics:body1 = </tn__bala2firesimplified_bSA/Geometry/chassis/wheel_right>
            point3f physics:localPos0 = (0, -0.04, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tn__bala2firesimplified_bSA>
            custom rel physics:body1
            append rel physics:body1 = </tn__bala2firesimplified_bSA/Geometry/chassis>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

