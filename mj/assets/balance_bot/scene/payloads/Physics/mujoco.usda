#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "balance_bot_scene"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "balance_bot_scene"
{
    over "Geometry"
    {
        over "ground" (
            prepend apiSchemas = ["MjcCollisionAPI"]
        )
        {
            uniform double[] mjc:solref = [0.02, 1]
        }

        over "chassis"
        {
            over "Box" (
                prepend apiSchemas = ["MjcImageableAPI"]
            )
            {
            }

            over "imu_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "wheel_left"
            {
                over "left_wheel_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:damping = 0.001
                }
            }

            over "wheel_right"
            {
                over "right_wheel_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:damping = 0.001
                }
            }
        }
    }

    over "Physics"
    {
        def MjcActuator "left_motor"
        {
            uniform double mjc:ctrlRange:max = 1
            uniform double mjc:ctrlRange:min = -1
            uniform double[] mjc:gear = [0.05, 0, 0, 0, 0, 0]
            custom rel mjc:target
            append rel mjc:target = </balance_bot_scene/Geometry/chassis/wheel_left/left_wheel_joint>
        }

        def MjcActuator "right_motor"
        {
            uniform double mjc:ctrlRange:max = 1
            uniform double mjc:ctrlRange:min = -1
            uniform double[] mjc:gear = [0.05, 0, 0, 0, 0, 0]
            custom rel mjc:target
            append rel mjc:target = </balance_bot_scene/Geometry/chassis/wheel_right/right_wheel_joint>
        }
    }
}

over "PhysicsScene" (
    prepend apiSchemas = ["MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:option:integrator = "implicitfast"
}

