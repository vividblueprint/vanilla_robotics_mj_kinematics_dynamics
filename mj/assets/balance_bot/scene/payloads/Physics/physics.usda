#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "balance_bot_scene"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "balance_bot_scene"
{
    over "Geometry"
    {
        over "ground" (
            prepend apiSchemas = ["NewtonCollisionAPI", "PhysicsMassAPI"]
        )
        {
            float newton:contactGap = 0
            float physics:density = 1000
        }

        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            uniform bool newton:jointsAddMobility = 1
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0.017)
            float3 physics:diagonalInertia = (0.00005679, 0.000054532, 0.000058722)
            float physics:mass = 0.127
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "imu_site" (
                prepend apiSchemas = ["NewtonSiteAPI"]
            )
            {
            }

            over "wheel_left" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.000002611, 0.000004303, 0.000002611)
                float physics:mass = 0.017
                quatf physics:principalAxes = (1, 0, 0, 0)

                def PhysicsRevoluteJoint "left_wheel_joint" (
                    prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                )
                {
                    float newton:armature = 0.000045
                    float newton:damping = 0.000017453292
                    float newton:friction = 0.001
                    uniform token physics:axis = "Y"
                    custom rel physics:body0
                    append rel physics:body0 = </balance_bot_scene/Geometry/chassis>
                    custom rel physics:body1
                    append rel physics:body1 = </balance_bot_scene/Geometry/chassis/wheel_left>
                    point3f physics:localPos0 = (0, 0.04, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }

            over "wheel_right" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.000002611, 0.000004303, 0.000002611)
                float physics:mass = 0.017
                quatf physics:principalAxes = (1, 0, 0, 0)

                def PhysicsRevoluteJoint "right_wheel_joint" (
                    prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                )
                {
                    float newton:armature = 0.000045
                    float newton:damping = 0.000017453292
                    float newton:friction = 0.001
                    uniform token physics:axis = "Y"
                    custom rel physics:body0
                    append rel physics:body0 = </balance_bot_scene/Geometry/chassis>
                    custom rel physics:body1
                    append rel physics:body1 = </balance_bot_scene/Geometry/chassis/wheel_right>
                    point3f physics:localPos0 = (0, -0.04, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.8
            float physics:staticFriction = 0.8
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI"]
)
{
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 200
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

