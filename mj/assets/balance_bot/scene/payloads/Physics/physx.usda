#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "balance_bot_scene"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "balance_bot_scene"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "wheel_left"
            {
                over "left_wheel_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "wheel_right"
            {
                over "right_wheel_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }
        }
    }
}

