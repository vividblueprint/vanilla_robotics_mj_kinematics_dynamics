#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "chassis_geom" (
        prepend references = @./geometries.usd@</Geometries/chassis_geom>
    )
    {
        over "chassis_geom" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding:physics = None
            double[] mjc:solref = [0.02, 1]
            float newton:contactGap = 0 (
                limits = {
                    dictionary hard = {
                        double minimum = 0
                    }
                }
            )
            token physics:approximation = "convexHull"
            float physics:density = 1000
        }
    }

    def Xform "wheel_left_geom" (
        prepend references = @./geometries.usd@</Geometries/wheel_left_geom>
    )
    {
        over "wheel_left_geom" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding:physics = None
            double[] mjc:solref = [0.02, 1]
            float newton:contactGap = 0 (
                limits = {
                    dictionary hard = {
                        double minimum = 0
                    }
                }
            )
            token physics:approximation = "convexHull"
            float physics:density = 1000
        }
    }
}

