#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "grid"
    {
        color3f inputs:diffuseColor = (0.99999994, 1, 0.9999999)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 1
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/grid/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/grid.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/grid.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/grid.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/grid.inputs:roughness>
            token outputs:surface
        }
    }
}

